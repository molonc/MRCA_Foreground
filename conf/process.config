process {

	//GLOBALS
	//executor = 'slurm'
	//queue = "upgrade"
	//clusterOptions = '--account=aparicio_lab'

    executor = 'local'   // run locally
    maxForks = 32 

    // Labels
    // publishDir is keyed purely on sample_id -- whatever the samplesheet's
    // sample_id column contains for this row is the results subdirectory name.
    withLabel: 'symlink_output' {
        publishDir = [
            path: { "${params.out_dir}/${sample_id}" },
            mode: 'symlink'
            ]

    }

   withLabel: 'copy_output' {
        publishDir = [
            path: { "${params.out_dir}/${sample_id}" },
            mode: 'copy'
            ]
   }

}
