/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    medicc2_foreground: root Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Auto-loaded on every invocation, BEFORE the -c config below. Only settings that don't
    depend on per-cohort params (out_dir, data_dir, ...) belong here — conf/base.config
    itself is intentionally NOT included from this file. It's included from the tail end
    of each conf/main/*.config / conf/dev/*.config, after that file's `params {}` block
    has already set out_dir/trace_report_suffix/etc., since conf/base.config's
    timeline/report/trace/dag blocks interpolate those params into output file paths and
    need them to already be set when they're evaluated. Run with, e.g.:

        nextflow run main.nf -c conf/main/SA609.config -profile conda

----------------------------------------------------------------------------------------
*/

nextflow.enable.dsl = 2

// Every process declares its own `conda` directive pointing at a tracked environment
// file (modules/fg_modules/*/{r44.yml,medicc2.yaml}), so the conda profile is the only
// one currently exercised. The singularity profile is scaffolded for anyone who wants
// to build/pull containers instead, but no containers are published for this pipeline
// yet.
profiles {
    conda {
        conda.enabled       = true
        conda.useMamba      = true
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        conda.enabled       = false
    }
}

// Default to the conda profile so the pipeline works even if -profile is omitted.
conda.enabled  = true
conda.useMamba = true
