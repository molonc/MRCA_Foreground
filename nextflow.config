/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    medicc2_foreground: root Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Auto-loaded on every invocation, BEFORE the -c config below. Only settings that don't
    depend on per-cohort params (out_dir, data_dir, ...) belong here — conf/base.config
    itself is intentionally NOT included from this file. It's included from the tail end
    of each conf/main/*.config / conf/dev/*.config, after that file's `params {}` block
    has already set out_dir/trace_report_suffix/etc., since conf/base.config's
    timeline/report/trace/dag blocks interpolate those params into output file paths and
    need them to already be set when they're evaluated. Run with, e.g.:

        nextflow run main.nf -c conf/main/SA609.config -profile singularity

----------------------------------------------------------------------------------------
*/

nextflow.enable.dsl = 2

// Every process declares a `container` directive (params.base_container /
// params.medicc2_container below) — there is no per-module `conda` directive/env file
// anymore. See containers/README.md for how the two images are built and why they
// exist -- in short, building each environment live on this pipeline's shared host was
// getting killed under memory pressure (or, for `base`, fighting a hand-pinned conda
// spec against packages it was never meant to provide -- see the README), so each is
// now built once into a local .sif (containers/base/, containers/medicc2/) and reused
// every run.
//
// This cluster has no Docker daemon, only Apptainer/Singularity -- both images are
// built directly here with `apptainer build` (see containers/*/*.def), so the
// container directives below just point at the resulting local .sif files. No
// registry, no pull step, no auth needed.
params {
    base_container    = "${projectDir}/containers/base/base.sif"
    medicc2_container = "${projectDir}/containers/medicc2/medicc2.sif"
}

// Every module invokes `Rscript ${projectDir}/modules/...` directly (an absolute host
// path, not a staged Nextflow input), and out_dir/phasing_object in the cohort configs
// also live under /projects/molonc/aparicio_lab -- none of that is something Nextflow's
// automatic singularity bind-mount detection (which only looks at staged *input* files)
// ever sees, so without an explicit bind here it's invisible inside the container once
// the task's cwd is off under workDir (/projects/molonc/scratch/ahamazaki/work/...):
// "Fatal error: cannot open file '.../modules/fg_modules/.../foo.R': No such file or
// directory". This never surfaced before because every prior run used `-profile conda`
// (no container, no bind-mount boundary) -- confirmed directly:
//   apptainer exec --no-home -B /projects/molonc/scratch/ahamazaki containers/base/base.sif \
//       ls /projects/molonc/aparicio_lab/        # -> No such file or directory
singularity.runOptions = '-B /projects/molonc/aparicio_lab'

profiles {
    singularity {
        singularity.enabled = true
    }
}

// Default to the singularity profile so the pipeline works even if -profile is omitted
// -- containers are the only supported execution path now.
singularity.enabled = true
